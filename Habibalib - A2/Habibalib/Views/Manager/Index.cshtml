<h2>Library Stats 📊</h2>

<h3>Item Status</h3>
<div class="item-grid">
    <div class="card-box"><b>Available</b><p>@ViewBag.AvailableCount</p></div>
    <div class="card-box"><b>Borrowed</b><p>@ViewBag.BorrowedCount</p></div>
    <div class="card-box"><b>Damaged</b><p>@ViewBag.DamagedCount</p></div>
    <div class="card-box"><b>Destroyed</b><p>@ViewBag.DestroyCount</p></div>
</div>

<h3>Item Totals</h3>
<div class="item-grid">
    <div class="card-box"><b>Total Books</b><p>@ViewBag.TotalBooks</p></div>
    <div class="card-box"><b>Total Music</b><p>@ViewBag.TotalMusic</p></div>
    <div class="card-box"><b>Total Toys</b><p>@ViewBag.TotalToys</p></div>
</div>

<h3>Borrowing</h3>
<div class="item-grid">
    <div class="card-box"><b>Total Borrows</b><p>@ViewBag.TotalBorrows</p></div>
    <div class="card-box"><b>Active Borrows</b><p>@ViewBag.ActiveBorrows</p></div>
</div>

<h3>Fines</h3>
<div class="item-grid">
    <div class="card-box"><b>Total Fine Charged</b><p>@ViewBag.TotalFine</p></div>
    <div class="card-box"><b>Unpaid Fine</b><p>@ViewBag.UnpaidFine</p></div>
</div>

<p><a href="/Manager/Reports">Open reports and CSV/PDF exports</a></p>
