@* Top bar shared by kiosk screens, with a Help overlay *@
<header class="k-header">
    <div class="k-header-title">CENTRAL BRANCH KIOSK</div>
    <div class="k-header-actions">
        <button type="button" class="k-help-btn" id="help-open">? Help</button>
        <button type="button" class="k-help-btn k-staff-btn" id="staff-open">&#128226; Call for Staff</button>
    </div>
</header>
<div id="staff" class="k-overlay" hidden>
    <div class="k-overlay-box">
        <h2>Staff have been called</h2>
        <p>A staff member will be with you shortly. Please wait at the kiosk.</p>
        <button type="button" class="k-btn" id="staff-close">OK</button>
    </div>
</div>
<div id="help" class="k-overlay" hidden>
    <div class="k-overlay-box">
        <h2>Need a hand?</h2>
        <ul>
            <li>Hold the barcode flat under the red laser line.</li>
            <li>If a barcode won't scan, tap <strong>Enter Barcode Manually</strong> and use the numpad.</li>
            <li>Tap <strong>Remove</strong> to undo an item you checked out by mistake.</li>
            <li>Tap <strong>Finish &amp; Print Receipt</strong> when you are done.</li>
            <li>The kiosk signs you out automatically after 60 seconds of inactivity.</li>
        </ul>
        <button type="button" class="k-btn" id="help-close">Got it</button>
    </div>
</div>
<script>
    document.getElementById('help-open').addEventListener('click', function () { document.getElementById('help').hidden = false; });
    document.getElementById('help-close').addEventListener('click', function () { document.getElementById('help').hidden = true; });
    document.getElementById('staff-open').addEventListener('click', function () { document.getElementById('staff').hidden = false; });
    document.getElementById('staff-close').addEventListener('click', function () { document.getElementById('staff').hidden = true; });
</script>
