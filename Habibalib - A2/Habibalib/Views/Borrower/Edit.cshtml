@model Habibalib.Models.Borrower

<h2>Edit Borrower ✏️</h2>

<div class="form-box">
    <form method="post" action="/Borrower/Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <label>Name</label>
        <input type="text" name="Name" value="@Model.Name" required />
        <label>Email</label>
        <input type="email" name="Email" value="@Model.Email" required />
        <label>Phone</label>
        <input type="text" name="Phone" value="@Model.Phone" />
        <label>Address</label>
        <input type="text" name="Address" value="@Model.Address" />
        <button type="submit" class="btn-pink">Update</button>
    </form>
</div>
